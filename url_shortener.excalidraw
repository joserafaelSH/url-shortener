    {
      "id": "jLQOiQ7BG0NdXUJZXn-tU",
      "type": "text",
      "x": 660.3095238095254,
      "y": 805.4523809523808,
      "width": 997.619384765625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
